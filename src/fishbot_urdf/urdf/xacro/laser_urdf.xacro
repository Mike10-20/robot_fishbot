<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="inertia_urdf.xacro"/>
    <xacro:macro name="laser_link" params="xyz">
        <gazebo reference="laser_link">
            <material>Gazebo/Black</material>
        </gazebo>
        <gazebo reference="laser_cylinder_link">
            <material>Gazebo/Black</material>
        </gazebo>
        <link name="laser_cylinder_link">
            <visual>
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>
                </geometry>
                <material name="green">
                    <color rgba="0.0 1.0 0.0 0.8"/>                  
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>
                </geometry>
                <material name="green">
                    <color rgba="0.0 1.0 0.0 0.8"/>                  
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.03" r="0.01" h="0.1"/>


        </link>
        <link name="laser_link">
            <visual>
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>
                </geometry>
                <material name="green">
                    <color rgba="0.0 1.0 0.0 0.8"/>                  
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>
                </geometry>
                <material name="green">
                    <color rgba="0.0 1.0 0.0 0.8"/>                  
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.03" r="0.02" h="0.02"/>

        </link>
        <joint name="laser_cylinder_link2base_link" type="fixed">
            <parent link="base_link"/>
            <child link="laser_cylinder_link"/>
            <origin xyz="${xyz}"/>
        </joint>
        <joint name="laser_link2laser_cylinder_link" type="fixed">
            <parent link="laser_cylinder_link"/>
            <child link="laser_link"/>
            <origin xyz="0 0 0.05"/>         
        </joint>
    </xacro:macro>   
</robot>