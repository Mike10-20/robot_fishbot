<robot name="link_urdf">
    <material name="yellow">
        <color rgba="0.8 0.6 0.0 0.5"/>
    </material>
    <material name="red">
        <color rgba="0.9 0.0 0.0 0.5"/>
    </material>
    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.001"/>
            </geometry>
        </visual>
    </link>
    <link name="base_link">
        <visual>
            <geometry>
                <box size="1.5 0.5 0.2"/>
            </geometry>
            <material name="yellow"/>
        </visual>
    </link>
    <link name="camera">
        <visual>
            <geometry>
                <box size="0.1 0.2 0.2"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>
    <joint name="camera2base_link" type="continuous">
        <parent link="base_link"/>
        <child link="camera"/>
        <origin xyz="0.6 0 0.2"/>
        <axis xyz="0.0 0.0 1"/>
    </joint>
    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.1"/>   
    </joint>
</robot>