<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="inertia_urdf.xacro"/>
    <xacro:macro name="wheel_link" params="wheel_name xyz">
        <gazebo reference="${wheel_name}_link">
            <material>Gazebo/Yellow</material>
            <mu1 value="20.0"/>
            <mu2 value="20.0"/>
            <kp value="1000000000.0"/>
            <kd value="1.0"/>

        </gazebo>
        <link name="${wheel_name}_link">
            <visual>
                <origin rpy="1.57079 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin rpy="1.57079 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.03" r="0.032" h="0.04"/>

        </link>
        <joint name="${wheel_name}_link2base_link" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <origin xyz="${xyz}"/>
            <axis xyz="0.0 1.0 0.0"/>        
        </joint>
    </xacro:macro>
</robot>