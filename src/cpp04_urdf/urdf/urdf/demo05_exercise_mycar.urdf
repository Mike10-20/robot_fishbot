<robot name="mycar">
    <material name="yellow">
        <color rgba="0.8 0.6 0.0 0.5"/>
    </material>
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
        </visual>      
    </link>
    <link name="base_link">
        <visual>
            <geometry>
                <box size="2 1.2 0.7"/>
            </geometry>
            <material name="yellow"/>
        </visual>
    </link>
    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.5"/>
    </joint>
    <link name="wheel1">
        <visual>
            <geometry>
                <cylinder radius="0.25" length="0.2"/>
            </geometry>
            <origin rpy="1.57 0.0 0.0"/>
            <material name="black"/>
        </visual>
    </link>
    <joint name="wheel1tobase_link" type="continuous">
        <parent link="base_link"/>
        <child link="wheel1"/>
        <origin xyz="0.7 0.6 -0.25"/>
        <axis xyz="0.0 1 0.0"/>
    </joint>
    <link name="wheel2">
        <visual>
            <geometry>
                <cylinder radius="0.25" length="0.2"/>
            </geometry>
            <origin rpy="1.57 0.0 0.0"/>
            <material name="black"/>
        </visual>
    </link>
    <joint name="wheel2tobase_link" type="continuous">
        <parent link="base_link"/>
        <child link="wheel2"/>
        <origin xyz="0.7 -0.6 -0.25"/>
        <axis xyz="0.0 1 0.0"/>

    </joint>
    <link name="wheel3">
        <visual>
            <geometry>
                <cylinder radius="0.25" length="0.2"/>
            </geometry>
            <origin rpy="1.57 0.0 0.0"/>
            <material name="black"/>
        </visual>
    </link>
    <joint name="wheel3tobase_link" type="continuous">
        <parent link="base_link"/>
        <child link="wheel3"/>
        <origin xyz="-0.7 0.6 -0.25"/>
        <axis xyz="0.0 1 0.0"/>

    </joint>
    <link name="wheel4">
        <visual>
            <geometry>
                <cylinder radius="0.25" length="0.2"/>
            </geometry>
            <origin rpy="1.57 0.0 0.0"/>
            <material name="black"/>
        </visual>
    </link>
    <joint name="wheel4tobase_link" type="continuous">
        <parent link="base_link"/>
        <child link="wheel4"/>
        <origin xyz="-0.7 -0.6 -0.25"/>
        <axis xyz="0.0 1 0.0"/>

    </joint>
    
</robot>