<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="laser_radius" value="0.3"/>
    <xacro:property name="laser_length" value="0.3"/>
    <xacro:property name="car_hight" value="0.7"/>

    <link name="laser">
        <visual>
            <geometry>
                <cylinder radius="${laser_radius}" length="${laser_length}"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 0.8 0.5"/>
            </material>
        </visual> 
    </link>
    <joint name="laser2base_link" type="continuous">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="0.0 0.0 ${car_hight/2+laser_length/2}"/>
        <axis xyz="0.0 0.0 1"/>
    </joint>
    
</robot>