<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="inertia_urdf.xacro"/>
    <xacro:macro name="base_link" params="radius length">
        <gazebo reference="base_link">
            <material>Gazebo/White</material>
        </gazebo>
        <link name="base_footprint">
            <visual>
                <geometry>
                    <sphere radius="0.0001"/>
                </geometry>
            </visual>
        </link>
        <link name="base_link">
            <visual>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 0.8"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 0.8"/>
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.2" r="${radius}" h="${length}"/>
        </link>
        <joint name="base_link2base_footprint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0.0 0.0 ${length/2.0+0.032}"/>
        </joint>
    </xacro:macro>
    <xacro:macro name="imu_link" params="xyz">
        <link name="imu_link">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.02"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.02 0.02"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.8"/>
                </material>
            </collision>
            <xacro:box_inertia m="0.03" w="0.02" h="0.02" d="0.02"/>
        </link>
        <joint name="imu_link2base_link" type="fixed">
            <parent link="base_link"/>
            <child link="imu_link"/>
            <origin xyz="${xyz}"/>
        </joint>
    </xacro:macro>
</robot>